module hfb_1 (
    input  wire               clk,       
    input  wire               reset,
   // input  wire               ce,      
    input  wire signed [15:0] data_in,    
    output reg  signed [15:0] even_out,
    output reg  signed [15:0] odd_out
);

    reg signed [15:0] d [0:15];
    integer i;

    wire signed [16:0] p0 = d[0] + d[15];
    wire signed [16:0] p1 = d[1] + d[14];
    wire signed [16:0] p2 = d[2] + d[13];
    wire signed [16:0] p3 = d[3] + d[12];
    wire signed [16:0] p4 = d[4] + d[11];
    wire signed [16:0] p5 = d[5] + d[10];
    wire signed [16:0] p6 = d[6] + d[9];
    wire signed [16:0] p7 = d[7] + d[8];

    wire signed [35:0] ext_p0 = $signed(p0);
    wire signed [35:0] ext_p1 = $signed(p1);
    wire signed [35:0] ext_p2 = $signed(p2);
    wire signed [35:0] ext_p3 = $signed(p3);
    wire signed [35:0] ext_p4 = $signed(p4);
    wire signed [35:0] ext_p5 = $signed(p5);
    wire signed [35:0] ext_p6 = $signed(p6);
    wire signed [35:0] ext_p7 = $signed(p7);

    wire signed [35:0] m0 = -ext_p0;                                           // FFFF = -1
    wire signed [35:0] m1 = ext_p1 <<< 1;                                      // 0002 = 2
    wire signed [35:0] m2 = -(ext_p2 <<< 2);                                   // FFFC = -4
    wire signed [35:0] m3 = ext_p3 <<< 3;                                      // 0008 = 8
    wire signed [35:0] m4 = (ext_p4 <<< 1) - (ext_p4 <<< 4);                   // FFF2 = -14  
    wire signed [35:0] m5 = (ext_p5 <<< 4) + (ext_p5 <<< 3) + ext_p5;          // 0019 = 25   
    wire signed [35:0] m6 = (ext_p6 <<< 4) - (ext_p6 <<< 6) - (ext_p6 <<< 1);  // FFCE = -50  
    wire signed [35:0] m7 = (ext_p7 <<< 7) + (ext_p7 <<< 5) + ext_p7;          // 00A1 = 161  

    wire signed [35:0] s01 = m0 + m1;
    wire signed [35:0] s23 = m2 + m3;
    wire signed [35:0] s45 = m4 + m5;
    wire signed [35:0] s67 = m6 + m7;
    wire signed [35:0] s0123 = s01 + s23;
    wire signed [35:0] s4567 = s45 + s67;
    wire signed [35:0] acc_final = s0123 + s4567;

    always @(posedge clk or negedge reset) begin
        if (!reset) begin 
            for (i = 0; i < 16; i = i + 1) begin
                d[i] <= 16'sd0;
            end
            even_out <= 16'sd0;
            odd_out  <= 16'sd0;
        end 
        else //if (ce)
           begin 
            d[0] <= data_in;
            for (i = 1; i < 16; i = i + 1) begin
                d[i] <= d[i-1];
            end
            even_out <= acc_final[24:9]; 
            odd_out  <= d[8] >>> 1; 
        end
    end
endmodule
