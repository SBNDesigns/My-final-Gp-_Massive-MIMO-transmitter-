module hfb_1 (
    input  wire               clk,       
    input  wire               reset,
    input  wire signed [15:0] data_in,    
    output reg  signed [15:0] even_out,
    output reg  signed [15:0] odd_out
);

   
    reg signed [15:0] h [0:15];
    
   
    reg signed [15:0] d [0:15];
    
    reg signed [35:0] acc;
    integer i, k; 

    initial begin
        $readmemh("C:/Users/ASAA/OneDrive/Desktop/Chain_RTL/RTL/h1.txt"", h);
    end

    always @(*) begin
        acc = 36'sd0;
       
        for (k = 0; k < 8; k = k + 1) begin
            acc = acc + (h[k] * (d[k] + d[15-k]));
        end
    end


    always @(posedge clk or negedge reset) begin
        if (!reset) begin 
            for (i = 0; i < 16; i = i + 1) begin
                d[i] <= 16'sd0;
            end
            even_out <= 16'sd0;
            odd_out  <= 16'sd0;
        end 
        else  begin
            d[0] <= data_in;
            for (i = 1; i < 16; i = i + 1) begin
                d[i] <= d[i-1];
            end
            even_out <= acc[24:9]; 
            odd_out  <= d[8] >>> 1; 
        end
    end

endmodule
